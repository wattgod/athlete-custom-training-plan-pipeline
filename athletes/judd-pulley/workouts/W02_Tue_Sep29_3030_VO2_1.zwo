<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
  <author>Gravel God Training</author>
  <name>30/30 VO2</name>
  <description>FUEL:
Normal meal ~2h before. One bottle, 40-50g carbs. Done.

WARM-UP:
• 15min building from Z1 to Z2, then 2x5min Z3 @ 100-120rpm with 1min Z2 between

MAIN SET:
• 2x(5x30sec @ 115% FTP / 30sec recovery), 3min between sets

COOL-DOWN:
• 10 min @ Z1 (RPE 1-2)
• Spin out the legs

EXECUTION:
• HYDRATION: 1 bottle/hr with electrolytes mandatory. Before hard efforts, take 1 gel. Light urine color (not clear) = well hydrated.
• VO2max intervals. Maximum aerobic power. Full recovery between efforts. Control the power—don't hero the first interval.</description>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="900" PowerLow="0.50" PowerHigh="0.75"/>
    <SteadyState Duration="300" Power="0.87" CadenceLow="100" CadenceHigh="120"/>
    <SteadyState Duration="60" Power="0.70"/>
    <SteadyState Duration="300" Power="0.87" CadenceLow="100" CadenceHigh="120"/>
    <IntervalsT Repeat="5" OnDuration="30" OnPower="1.15" OffDuration="30" OffPower="0.50"/>
    <SteadyState Duration="180" Power="0.50"/>
    <IntervalsT Repeat="5" OnDuration="30" OnPower="1.15" OffDuration="30" OffPower="0.50"/>
    <Cooldown Duration="600" PowerLow="0.65" PowerHigh="0.50"/>
  </workout>
</workout_file>