<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
  <author>Gravel God Training</author>
  <name>Endurance Tempo</name>
  <description>WARM-UP:
• 15min progressive warm-up

MAIN SET:
• 30min steady @Z3 (tempo)

COOL-DOWN:
• 15min @Z1/Z2

EXECUTION:
• Steady tempo — comfortably hard, a pace where full sentences are tough but you're not gasping.

RPE guide: 81% FTP -> RPE 5-6</description>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="900" PowerLow="0.00" PowerHigh="0.87"/>
    <SteadyState Duration="1800" Power="0.81"/>
    <Cooldown Duration="900" PowerLow="0.75" PowerHigh="0.00"/>
  </workout>
</workout_file>