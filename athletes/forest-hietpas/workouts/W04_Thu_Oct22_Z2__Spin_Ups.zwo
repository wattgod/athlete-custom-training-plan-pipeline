<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
  <author>Gravel God Training</author>
  <name>OPTIONAL: Z2 + Spin Ups</name>
  <description>MAIN SET:
• 60-90min Z2 (60-68% FTP), simple and clean
• 4x30sec spin-ups @ 110+ rpm — not about power, just waking the legs up

EXECUTION:
• Keep it simple — the spin-ups are texture, not intervals.

RPE guide: 64% FTP -> RPE 3</description>
  <sportType>bike</sportType>
  <workout>
    <SteadyState Duration="900" Power="0.64"/>
    <IntervalsT Repeat="4" OnDuration="30" OnPower="0.64" OffDuration="870" OffPower="0.64"/>
    <SteadyState Duration="120" Power="0.64"/>
  </workout>
</workout_file>