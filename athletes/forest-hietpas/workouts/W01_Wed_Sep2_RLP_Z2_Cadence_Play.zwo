<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
  <author>Gravel God Training</author>
  <name>RLP Z2 Cadence Play</name>
  <description>Easy session predominantly in zone 2 but skirting the Z1 and Z3 borders. Alternating blocks built for Smart Trainer/Strava usage.

RPE guide: 66% FTP -> RPE 3; 60% FTP -> RPE 3</description>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="300" PowerLow="0.50" PowerHigh="0.50"/>
    <SteadyState Duration="240" Power="0.60" CadenceLow="80" CadenceHigh="90"/>
    <SteadyState Duration="240" Power="0.66" CadenceLow="85" CadenceHigh="85"/>
    <SteadyState Duration="60" Power="0.66" CadenceLow="100" CadenceHigh="100"/>
    <SteadyState Duration="180" Power="0.66" CadenceLow="85" CadenceHigh="85"/>
    <SteadyState Duration="120" Power="0.66" CadenceLow="100" CadenceHigh="100"/>
    <SteadyState Duration="120" Power="0.66" CadenceLow="85" CadenceHigh="85"/>
    <SteadyState Duration="180" Power="0.66" CadenceLow="100" CadenceHigh="100"/>
    <SteadyState Duration="120" Power="0.66" CadenceLow="85" CadenceHigh="85"/>
    <SteadyState Duration="120" Power="0.66" CadenceLow="100" CadenceHigh="100"/>
    <SteadyState Duration="180" Power="0.66" CadenceLow="85" CadenceHigh="85"/>
    <SteadyState Duration="60" Power="0.66" CadenceLow="100" CadenceHigh="100"/>
    <SteadyState Duration="240" Power="0.66" CadenceLow="85" CadenceHigh="85"/>
    <SteadyState Duration="240" Power="0.60" CadenceLow="80" CadenceHigh="90"/>
    <Cooldown Duration="300" PowerLow="0.50" PowerHigh="0.50"/>
  </workout>
</workout_file>