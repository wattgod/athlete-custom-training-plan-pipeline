<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
  <author>Gravel God Training</author>
  <name>Broken VO2 40/20 (1 of 2)</name>
  <description>FUEL:
Normal meal ~2h before. One bottle, 40-50g carbs. Done.

• STRUCTURE:
  - 15min warmup Z2, 2x6x40sec on (110% FTP) / 20sec off (50% FTP), 5min recovery between sets

• EXECUTION:
  - Learning the format - controlled efforts

RPE guide: 110% FTP -> RPE 8-9; 50% FTP -> RPE 3</description>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="900" PowerLow="0.65" PowerHigh="0.75"/>
    <IntervalsT Repeat="6" OnDuration="40" OnPower="1.10" OffDuration="20" OffPower="0.50"/>
    <SteadyState Duration="300" Power="0.50"/>
    <IntervalsT Repeat="6" OnDuration="40" OnPower="1.10" OffDuration="20" OffPower="0.50"/>
    <Cooldown Duration="600" PowerLow="0.65" PowerHigh="0.50"/>
  </workout>
</workout_file>