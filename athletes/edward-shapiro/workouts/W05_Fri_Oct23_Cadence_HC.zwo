<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
  <author>Gravel God Training</author>
  <name>Cadence HC</name>
  <description>FUEL:
Normal meal ~2h before. One bottle, 40-50g carbs. Done.

Warm up for 5min
-

5x1min high cadence (105-110 rpm) Z3; 3 min normal spinning Z2
-
Finish out workout with steady riding.

RPE guide: 82% FTP -> RPE 5-6; 75% FTP -> RPE 3</description>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="300" PowerLow="0.40" PowerHigh="0.50"/>
    <IntervalsT Repeat="5" OnDuration="60" OnPower="0.82" CadenceLow="105" CadenceHigh="115" OffDuration="180" OffPower="0.55"/>
    <SteadyState Duration="600" Power="0.75"/>
  </workout>
</workout_file>