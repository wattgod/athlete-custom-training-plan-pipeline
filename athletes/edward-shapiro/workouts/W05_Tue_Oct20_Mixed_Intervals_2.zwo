<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
  <author>Gravel God Training</author>
  <name>Mixed Intervals (2 of 2)</name>
  <description>FUEL:
Normal meal ~2h before. One bottle, 40-50g carbs. Done.

WARM-UP:
• 10min building from Z1 to Z2 (RPE 3-4)
• 5min high cadence Z3 (100+ rpm) to prime efforts (RPE 5-6)

MAIN SET:
• 5min @ 76-87% FTP, RPE 5-6
• 2min @ 106-120% FTP, RPE 9
• 3min @ 93-105% FTP, RPE 7-8
• 2min @ 106-120% FTP, RPE 9
• 3min @ 93-105% FTP, RPE 7-8
• 2min @ 106-120% FTP, RPE 9
• 3min @ 93-105% FTP, RPE 7-8
• 2min @ 106-120% FTP, RPE 9
• 3min @ 93-105% FTP, RPE 7-8
• 2min @ 106-120% FTP, RPE 9
• 3min @ 93-105% FTP, RPE 7-8
• Cadence: 85-95rpm (variable as terrain demands)
• Position: Seated, hoods or drops

COOL-DOWN:
• 10min easy spin Z1-Z2 (RPE 3-4)</description>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="600" PowerLow="0.50" PowerHigh="0.65"/>
    <SteadyState Duration="300" Power="0.85" CadenceLow="100" CadenceHigh="100"/>
    <SteadyState Duration="120" Power="1.10"/>
    <SteadyState Duration="180" Power="0.98"/>
    <SteadyState Duration="180" Power="0.55"/>
    <SteadyState Duration="120" Power="1.10"/>
    <SteadyState Duration="180" Power="0.98"/>
    <SteadyState Duration="180" Power="0.55"/>
    <SteadyState Duration="120" Power="1.10"/>
    <SteadyState Duration="180" Power="0.98"/>
    <SteadyState Duration="180" Power="0.55"/>
    <SteadyState Duration="120" Power="1.10"/>
    <SteadyState Duration="180" Power="0.98"/>
    <SteadyState Duration="180" Power="0.55"/>
    <SteadyState Duration="120" Power="1.10"/>
    <SteadyState Duration="180" Power="0.98"/>
    <Cooldown Duration="600" PowerLow="0.65" PowerHigh="0.50"/>
  </workout>
</workout_file>