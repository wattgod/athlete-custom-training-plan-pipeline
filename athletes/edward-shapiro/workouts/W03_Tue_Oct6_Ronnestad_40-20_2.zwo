<workout_file>
  <author>Gravel God Training</author>
  <name>Ronnestad 40-20 (2 of 2)</name>
  <description>FUEL:
Normal meal ~2h before. One bottle, 40-50g carbs. Done.

Ronnestad 40/20 — level 4

WARM-UP:
• 5min ramp 50%->70% FTP
• 6min @85%-91% FTP
• 3min @45%-55% FTP
• 3x 20s @125% FTP / 40s @45%-55%
• 2min @45%-55% FTP

MAIN SET:
• 3 sets of 9x 40s @109%-115% FTP / 20s @45%-55%, 4min @45%-55% FTP recovery

COOL-DOWN:
-10min spin-down 70%->50% FTP (RPE 2-3)

EXECUTION:
-Hit target from the start; easy, full recoveries. End the set if the power fades.

NUTRITION:
-40-60g carbs/hr.</description>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="300" PowerLow="0.50" PowerHigh="0.70" CadenceLow="90" CadenceHigh="95"/>
    <SteadyState Duration="360" Power="0.88" CadenceLow="90" CadenceHigh="95"/>
    <SteadyState Duration="180" Power="0.50" CadenceLow="95" CadenceHigh="100"/>
    <IntervalsT Repeat="3" OnDuration="20" OnPower="1.25" CadenceLow="105" CadenceHigh="105" OffDuration="40" OffPower="0.50"/>
    <SteadyState Duration="120" Power="0.50" CadenceLow="95" CadenceHigh="100"/>
    <IntervalsT Repeat="9" OnDuration="40" OnPower="1.12" CadenceLow="100" CadenceHigh="100" OffDuration="20" OffPower="0.50"/>
    <SteadyState Duration="240" Power="0.50" CadenceLow="85" CadenceHigh="95"/>
    <IntervalsT Repeat="9" OnDuration="40" OnPower="1.12" CadenceLow="100" CadenceHigh="100" OffDuration="20" OffPower="0.50"/>
    <SteadyState Duration="240" Power="0.50" CadenceLow="85" CadenceHigh="95"/>
    <IntervalsT Repeat="9" OnDuration="40" OnPower="1.12" CadenceLow="100" CadenceHigh="100" OffDuration="20" OffPower="0.50"/>
    <Cooldown Duration="600" PowerLow="0.70" PowerHigh="0.50" CadenceLow="85" CadenceHigh="95"/>
  </workout>
</workout_file>