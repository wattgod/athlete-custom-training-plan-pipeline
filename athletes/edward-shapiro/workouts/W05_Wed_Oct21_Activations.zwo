<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
  <author>Gravel God Training</author>
  <name>Activations</name>
  <description>FUEL:
Target 65g carbs/hr. Practice this prescription.

10 min Z1>Z2 warm up; light gears
-
3sets:
8x30 seconds high cadence (>105 rpm) in Z3; 1 min easy spinning; 8 min Z2 between sets.-
8 min Z2 for time.

RPE guide: 83% FTP -> RPE 5-6; 66% FTP -> RPE 3</description>
  <sportType>bike</sportType>
  <workout>
    <SteadyState Duration="600" Power="0.66"/>
    <IntervalsT Repeat="8" OnDuration="30" OnPower="0.83" CadenceLow="105" CadenceHigh="115" OffDuration="60" OffPower="0.55"/>
    <SteadyState Duration="480" Power="0.66"/>
    <IntervalsT Repeat="8" OnDuration="30" OnPower="0.83" CadenceLow="105" CadenceHigh="115" OffDuration="60" OffPower="0.55"/>
    <SteadyState Duration="480" Power="0.66"/>
    <IntervalsT Repeat="8" OnDuration="30" OnPower="0.83" CadenceLow="105" CadenceHigh="115" OffDuration="60" OffPower="0.55"/>
    <SteadyState Duration="1680" Power="0.66"/>
  </workout>
</workout_file>