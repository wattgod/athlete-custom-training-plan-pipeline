<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
  <author>Gravel God Training</author>
  <name>Descending-Cadence Ladder</name>
  <description>FUEL:
Normal meal ~2h before. One bottle, 40-50g carbs. Done.

WARM-UP:
-15min building Z1->Z2

MAIN SET:
-4x 5min ALL at 85% FTP, but cadence steps DOWN each rep: 70 -> 60 -> 50 -> 45rpm
-Torque rises every rung because power is held flat as rpm drops
-3min easy spin between rungs

EXECUTION:
-Seated, smooth, keep power flat - shift to a bigger gear each rung, don't push harder. Watch the knees on the 45rpm rung; bail if they protest.

NUTRITION:
-40-60g carbs/hr.

HYDRATION:
-500-750ml/hr.

RPE guide: 85% FTP -> RPE 5-6; 55% FTP -> RPE 3</description>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="900" PowerLow="0.50" PowerHigh="0.72" CadenceLow="85" CadenceHigh="95"/>
    <SteadyState Duration="300" Power="0.85" CadenceLow="68" CadenceHigh="72"/>
    <SteadyState Duration="180" Power="0.55" CadenceLow="85" CadenceHigh="95"/>
    <SteadyState Duration="300" Power="0.85" CadenceLow="58" CadenceHigh="62"/>
    <SteadyState Duration="180" Power="0.55" CadenceLow="85" CadenceHigh="95"/>
    <SteadyState Duration="300" Power="0.85" CadenceLow="48" CadenceHigh="52"/>
    <SteadyState Duration="180" Power="0.55" CadenceLow="85" CadenceHigh="95"/>
    <SteadyState Duration="300" Power="0.85" CadenceLow="43" CadenceHigh="47"/>
    <Cooldown Duration="600" PowerLow="0.70" PowerHigh="0.50" CadenceLow="85" CadenceHigh="95"/>
  </workout>
</workout_file>