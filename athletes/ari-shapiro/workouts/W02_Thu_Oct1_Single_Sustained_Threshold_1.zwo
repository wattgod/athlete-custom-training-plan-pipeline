<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
  <author>Gravel God Training</author>
  <name>Single Sustained Threshold (1 of 2)</name>
  <description>FUEL:
Normal meal ~2h before. One bottle, 40-50g carbs. Done.

Single Sustained Threshold — level 2

WARM-UP:
• 6min ramp 50%->75% FTP
• 1:30 @87%-93% FTP
• 30s @50%-60% FTP
• 1:30 @92%-98% FTP
• 30s @50%-60% FTP
• 2min @55%-65% FTP

MAIN SET:
-25min @ 93%-99% FTP (Z4, RPE 6-7, 85-95rpm)

COOL-DOWN:
-10min spin-down 70%->50% FTP (RPE 2-3)

EXECUTION:
-Pace it so the last rep matches the first. Controlled, not heroic.

NUTRITION:
-Hydrate well; light fuel.</description>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="360" PowerLow="0.50" PowerHigh="0.75" CadenceLow="90" CadenceHigh="95"/>
    <SteadyState Duration="90" Power="0.90" CadenceLow="90" CadenceHigh="95"/>
    <SteadyState Duration="30" Power="0.55" CadenceLow="95" CadenceHigh="100"/>
    <SteadyState Duration="90" Power="0.95" CadenceLow="90" CadenceHigh="95"/>
    <SteadyState Duration="30" Power="0.55" CadenceLow="95" CadenceHigh="100"/>
    <SteadyState Duration="120" Power="0.60" CadenceLow="90" CadenceHigh="95"/>
    <SteadyState Duration="1500" Power="0.96" CadenceLow="85" CadenceHigh="95"/>
    <Cooldown Duration="600" PowerLow="0.70" PowerHigh="0.50" CadenceLow="85" CadenceHigh="95"/>
  </workout>
</workout_file>