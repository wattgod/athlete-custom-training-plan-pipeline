<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
  <author>Gravel God Training</author>
  <name>Descending-Cadence Ladder</name>
  <description>FUEL:
Normal meal ~2h before. One bottle, 40-50g carbs. Done.

WARM-UP:
-15-20min progressing Z1->Z2
-1x10min high-cadence Z3 @100-120rpm (wake up leg speed before the grind)

MAIN SET:
-4x 4min ALL at 82% FTP, cadence steps DOWN: 75->65->55->50rpm
-Torque rises every rung because power stays flat as rpm drops
-3min easy spin between rungs

EXECUTION:
-Seated, smooth, keep power flat - shift to a bigger gear each rung, don't push harder. Watch knees on the lowest rung.

NUTRITION:
-40-70g carbs/hr.

HYDRATION:
-500-750ml/hr.

RPE guide: 82% FTP -> RPE 5-6; 80% FTP -> RPE 5-6; 55% FTP -> RPE 3</description>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="900" PowerLow="0.50" PowerHigh="0.70" CadenceLow="85" CadenceHigh="95"/>
    <SteadyState Duration="600" Power="0.80" CadenceLow="100" CadenceHigh="120"/>
    <SteadyState Duration="240" Power="0.82" CadenceLow="73" CadenceHigh="77"/>
    <SteadyState Duration="180" Power="0.55" CadenceLow="85" CadenceHigh="95"/>
    <SteadyState Duration="240" Power="0.82" CadenceLow="63" CadenceHigh="67"/>
    <SteadyState Duration="180" Power="0.55" CadenceLow="85" CadenceHigh="95"/>
    <SteadyState Duration="240" Power="0.82" CadenceLow="53" CadenceHigh="57"/>
    <SteadyState Duration="180" Power="0.55" CadenceLow="85" CadenceHigh="95"/>
    <SteadyState Duration="240" Power="0.82" CadenceLow="48" CadenceHigh="52"/>
    <Cooldown Duration="600" PowerLow="0.70" PowerHigh="0.50" CadenceLow="85" CadenceHigh="95"/>
  </workout>
</workout_file>