<?xml version='1.0' encoding='UTF-8'?>
<workout_file>
  <author>Gravel God Training</author>
  <name>Kolie Moore TTE (2 of 2)</name>
  <description>FUEL:
Normal meal ~2h before. One bottle, 40-50g carbs. Done.

WARM-UP:
-15min building Z1->Z2

MAIN SET:
-2x 25min @98% FTP (self-paced: start ~96%, float to 100-102% late)
-10min @55% between
-Cadence: 85-95rpm, relaxed

EXECUTION:
-Ride on feel, let power drift up at the end. Accumulating time near threshold matters more than a flat line.

NUTRITION:
-60-80g carbs/hr from 30-45min.

HYDRATION:
-500-750ml/hr.

RPE guide: 98% FTP -> RPE 6-7; 55% FTP -> RPE 3</description>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="900" PowerLow="0.50" PowerHigh="0.75" CadenceLow="85" CadenceHigh="95"/>
    <SteadyState Duration="1500" Power="0.98" CadenceLow="85" CadenceHigh="95"/>
    <SteadyState Duration="600" Power="0.55" CadenceLow="85" CadenceHigh="95"/>
    <SteadyState Duration="1500" Power="0.98" CadenceLow="85" CadenceHigh="95"/>
    <Cooldown Duration="600" PowerLow="0.70" PowerHigh="0.50" CadenceLow="85" CadenceHigh="95"/>
  </workout>
</workout_file>